{
  "name": "a2a-mcp-bridge",
  "version": "0.1.0",
  "description": "Bidirectional protocol-metadata translator between Google A2A (Agent-to-Agent) and the Model Context Protocol (MCP). MCP server.json + tools/list → A2A AgentCard, and vice versa.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "mizcausevic-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/mizcausevic-dev/a2a-mcp-bridge"
  },
  "keywords": [
    "a2a",
    "agent-to-agent",
    "mcp",
    "model-context-protocol",
    "bridge",
    "agent-card",
    "interop",
    "typescript"
  ],
  "bin": {
    "a2a-mcp-bridge": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "demo": "tsx src/cli.ts --direction mcp-to-a2a --server-json fixtures/sample-server.json --tools-list fixtures/sample-tools.json",
    "bridge": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
